{% extends 'base.html.twig' %}
{% set menu = 'parcels' %}

{% block title %}Parcely{% endblock %}

{% block body %}
    <h1>Parcely</h1>

    {{ include('list/_filters.html.twig', {
        filters: [
            {name: 'f_municipality_id', label: 'Obec', type: 'hidden', value: query.municipalityId, title: municipality.name ?? null},
            {name: 'f_municipality', label: 'Obec', type: 'autocomplete', value: query.municipality},
            {name: 'f_land_type', label: 'Druh', type: 'select', value: query.landType, options: land_types},
        ],
        search: {value: query.search, placeholder: 'číslo parcely nebo kód k. ú.'},
    }) }}
    {{ include('list/_info.html.twig', {item_name: 'parcel', search: query.search}) }}

    {% if list.total == 0 %}
        <p class="empty">Nebyly nalezeny žádné parcel.</p>
    {% else %}
        <table class="table-list">
            <thead>
                <tr>
                    <th class="w-[18%]">Obec</th>
                    <th class="w-[20%]">{{ include('list/_sort_link.html.twig', {label: 'Katastrální území', key: 'p.cadastral_area'}) }}</th>
                    <th class="w-[8%]">Parcela</th>
                    <th class="w-[6%]">LV</th>
                    <th class="w-[14%]">Druh pozemku</th>
                    <th class="w-[9%]">{{ include('list/_sort_link.html.twig', {label: 'Výměra', key: 'p.area_m2'}) }}</th>
                    <th class="w-[25%]">Vlastníci</th>
                </tr>
            </thead>
            <tbody>
                {% for p in list.items %}
                    {% set parcel_owners = owners[p.id] ?? [] %}
                    {% set lv = [] %}
                    {% for os in parcel_owners %}
                        {% if os.lvNumber not in lv %}{% set lv = lv|merge([os.lvNumber]) %}{% endif %}
                    {% endfor %}
                    <tr>
                        <td>{{ p.municipality.name }}</td>
                        <td>{{ p.cadastralArea }}</td>
                        <td>{{ p.parcelNumber }}</td>
                        <td>{{ lv|join(', ') }}</td>
                        <td>{{ p.landType|capitalize }}</td>
                        <td>{{ p.area }}</td>
                        <td>
                            {%- for os in parcel_owners -%}
                                {% if not loop.first %}<br>{% endif %}<a href="{{ path('owner_detail', {id: os.owner.id}) }}">{{ os.owner.displayName }}</a> <small>({{ os.shareLabel }})</small>
                            {%- else -%}
                                <span class="muted">bez vlastníka</span>
                            {%- endfor -%}
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
        {{ include('list/_pagination.html.twig') }}
    {% endif %}

    <p class="hint">Hledat lze podle čísla parcely (např. „st. 121“ nebo „1517/9“) nebo kódu katastrálního území.</p>
{% endblock %}
